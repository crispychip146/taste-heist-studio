PORT=3100
HOST=127.0.0.1
# Key belongs only on the server. Never add it to public/ or a command argument.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
# Server-side research limits.
QLOO_RESEARCH_BUDGET=24
QLOO_REQUESTS_PER_MINUTE=30
# Set to your exact public origin behind a production TLS reverse proxy.
# PUBLIC_ORIGIN=https://your-domain.example
# Trust only the actual proxy peer IPs/networks; leave empty for a directly exposed Node server.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Provider allowance is counted in harness operations; workflows may issue multiple API requests.
QLOO_DAILY_BUDGET=1000
QLOO_ROOM_DAILY_BUDGET=120
QLOO_PLAYER_DAILY_BUDGET=120
QLOO_QUEUE_LIMIT=24
QLOO_WORKFLOW_TIMEOUT_MS=60000
RESEARCH_CONCURRENCY=4
ARTWORK_CONCURRENCY=4
ARTWORK_QUEUE_LIMIT=24
WS_PER_SEAT=3
WS_PER_ROOM=12
WS_CONNECTIONS=128
WS_BUFFER_BYTES=262144
# Set NODE_ENV=production for public hosting; an HTTPS PUBLIC_ORIGIN is then required.
